{
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; frame-src 'self'; connect-src 'none'; form-action 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/Thriver%20Companion%20-%20Onboarding.html",
      "destination": "/index.html"
    },
    {
      "source": "/Thriver%20Companion%20-%20Wireframes.html",
      "destination": "/review.html"
    },
    {
      "source": "/Thriver%20Companion%20-%20Slide%20guide.html",
      "destination": "/slide-guide.html"
    }
  ]
}
